// src/components/ItemCard.jsx
import { useEffect, useMemo, useRef, useState } from "react";
import { useCart } from "../store/cartStore";
import Icon from "./Icon";

/** 🔧 COMMON IMAGE
 *  Use a direct image URL (jpg/png/webp), NOT a Google redirect.
 *  You can also set VITE_MENU_IMG in your .env to override.
 */
const COMMON_IMAGE =
  import.meta?.env?.VITE_MENU_IMG ||
  "https://images.unsplash.com/photo-1540189549336-e6e99c3679fe?w=1200&q=80&auto=format&fit=crop"; // <- replace with your own direct image

// true = same image for ALL items; false = use item image and fallback to common
const USE_COMMON_IMAGE_ONLY = true;

// number helper
const num = (v) => (Number.isFinite(Number(v)) ? Number(v) : 0);

// robust getter
function getVal(item, key) {
  const alt = key.includes(".") ? key.replaceAll(".", "_") : key.replaceAll("_", ".");
  if (item?.[key] !== undefined) return item[key];
  if (item?.[alt] !== undefined) return item[alt];
  if (item?._raw?.[key] !== undefined) return item._raw[key];
  if (item?._raw?.[alt] !== undefined) return item._raw[alt];
  return undefined;
}

export default function ItemCard({
  item,
  onQuickAdd,
  onOpen,
  onModifiers,
  qtyInCart, // (unused; we read from store)
}) {
  // cart actions + items
  const items  = useCart((s) => s.items);
  const inc    = useCart((s) => s.inc);
  const dec    = useCart((s) => s.dec);
  const remove = useCart((s) => s.remove);

  // normalize id/name so the key matches cartStore.add()
  const itemId = useMemo(() => {
    return (
      getVal(item, "id") ??
      getVal(item, "pm.ID") ??
      getVal(item, "pm_ID") ??
      getVal(item, "product_id") ??
      getVal(item, "pm.ProductID") ??
      getVal(item, "pm_ProductID") ??
      null
    );
  }, [item]);

  const itemName = useMemo(() => {
    return (
      item?.name ??
      getVal(item, "pm.Description") ??
      getVal(item, "pm_Description") ??
      getVal(item, "pm.ShortDescription") ??
      getVal(item, "pm_ShortDescription") ??
      "Item"
    );
  }, [item]);

  // 🖼 pick image: force COMMON or fallback to it
  const pickImage = (it) =>
    USE_COMMON_IMAGE_ONLY ? COMMON_IMAGE : (it?.img || it?.image || COMMON_IMAGE);

  const [imgSrc, setImgSrc] = useState(pickImage(item));
  useEffect(() => {
    setImgSrc(pickImage(item));
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [item?.img, item?.image]); // if forcing common, this still keeps one source

  const initial = (itemName || "?").trim().charAt(0).toUpperCase() || "?";

  // === PRICE: UnitPrice + Tax1Amount ===
  const unitPrice = useMemo(() => {
    const v =
      getVal(item, "pc.UnitPrice") ??
      getVal(item, "pc_UnitPrice") ??
      getVal(item, "price") ??
      0;
    return num(v);
  }, [item]);

  const tax1Amount = useMemo(() => {
    const v =
      getVal(item, "pc.Tax1Amount") ??
      getVal(item, "pc_Tax1Amount") ??
      0;
    return num(v);
  }, [item]);

  const totalPrice = useMemo(
    () => Number((unitPrice + tax1Amount).toFixed(2)),
    [unitPrice, tax1Amount]
  );

  // payload to cart
  const itemForCart = useMemo(
    () => ({ ...item, id: itemId, name: itemName, price: totalPrice }),
    [item, itemId, itemName, totalPrice]
  );

  // cart key for "no-mods"
  const baseKey = useMemo(
    () => JSON.stringify({ id: itemId, mods: [] }),
    [itemId]
  );

  // qty from store
  const qtyFromStore = useMemo(() => {
    const line = items.find((x) => x._k === baseKey);
    return line?.qty ?? 0;
  }, [items, baseKey]);

  const hasModifiers = Array.isArray(item?.modifiers)
    ? item.modifiers.length > 0
    : !!item?.hasModifiers;

  // ripple + haptics
  const vibrate = (ms = 8) => {
    if (typeof navigator !== "undefined" && navigator.vibrate) navigator.vibrate(ms);
  };
  const setRipple = (e) => {
    const r = e.currentTarget.getBoundingClientRect();
    e.currentTarget.style.setProperty("--x", `${e.clientX - r.left}px`);
    e.currentTarget.style.setProperty("--y", `${e.clientY - r.top}px`);
  };

  // a11y live region
  const liveRef = useRef(null);
  useEffect(() => {
    if (liveRef.current) liveRef.current.textContent = `Quantity ${qtyFromStore}`;
  }, [qtyFromStore]);

  // group badge
  const groupDesc = getVal(item, "gm.GroupDescription") ?? getVal(item, "gm_GroupDescription");

  return (
    <article className="bg-white rounded-2xl ring-1 ring-gray-100 shadow-sm overflow-hidden hover:shadow-md transition">
      {/* IMAGE */}
      <div className="relative w-full aspect-square sm:aspect-[4/3] bg-slate-100">
        {imgSrc ? (
          <img
            src={imgSrc}
            alt={itemName}
            loading="lazy"
            onError={() => {
              // if given link fails, fall back to the common image; if that fails, show initial tile
              if (imgSrc !== COMMON_IMAGE) setImgSrc(COMMON_IMAGE);
              else setImgSrc(null);
            }}
            className="w-full h-full object-cover"
            referrerPolicy="no-referrer"
          />
        ) : (
          <div className="w-full h-full grid place-items-center">
            <div
              className="w-12 h-12 rounded-lg grid place-items-center text-white text-sm font-bold"
              style={{ background: "linear-gradient(135deg,var(--grad-start),var(--grad-end))" }}
              aria-hidden
            >
              {initial}
            </div>
          </div>
        )}

        {/* Category badge */}
        {groupDesc && (
          <div className="absolute top-2 left-2 px-2 py-1 rounded text-[10px] bg-white/90 text-gray-700 shadow-sm">
            {groupDesc}
          </div>
        )}

        {/* More info (top-right) */}
        <button
          onClick={onOpen ? () => onOpen(itemForCart) : undefined}
          className="absolute top-2 right-2 h-8 w-8 rounded-full bg-white/85 backdrop-blur border border-gray-200 shadow grid place-items-center active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--grad-start)]"
          aria-label={`More info about ${itemName}`}
          title="More info"
        >
          <Icon name="info" className="w-4 h-4 text-slate-700" />
        </button>

        {/* Customize (bottom-left) */}
        {hasModifiers && (
          <button
            onClick={(e) => {
              setRipple(e);
              vibrate(8);
              onModifiers?.(itemForCart);
            }}
            onPointerDown={setRipple}
            className="absolute bottom-2 left-2 h-8 px-3 rounded-full border border-gray-200 bg-white text-gray-800 text-[11px] font-medium shadow-sm active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--grad-start)]"
            title="Customize"
            aria-label="Customize"
          >
            <span className="flex items-center gap-1.5">
              <Icon name="sliders" className="w-4 h-4" />
              <span className="hidden xs:inline">Customize</span>
              <span className="xs:hidden">Mods</span>
            </span>
            <span className="btn-ripple" aria-hidden />
          </button>
        )}

        {/* Add / Stepper (bottom-right) */}
        {qtyFromStore <= 0 ? (
          <button
            onClick={(e) => {
              setRipple(e);
              vibrate(10);
              onQuickAdd?.(itemForCart);
            }}
            onPointerDown={setRipple}
            className="absolute bottom-2 right-2 h-9 px-3 rounded-full text-white text-xs sm:text-sm font-semibold shadow-md flex items-center gap-1.5 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--grad-start)]"
            style={{ background: "linear-gradient(90deg,var(--grad-start),var(--grad-end))" }}
            aria-label={`Add ${itemName} to cart`}
            title="Add to cart"
          >
            <Icon name="plus" className="w-4 h-4" />
            <span className="hidden sm:inline">Add to Cart</span>
            <span className="sm:hidden">Add</span>
            <span className="btn-ripple" aria-hidden />
          </button>
        ) : (
          <div
            className="absolute bottom-2 right-2 h-9 rounded-full shadow-md overflow-hidden flex items-center select-none"
            style={{ background: "linear-gradient(90deg,var(--grad-start),var(--grad-end))" }}
            role="group"
            aria-label={`Quantity controls for ${itemName}`}
          >
            <button
              onClick={(e) => {
                setRipple(e);
                vibrate(6);
                if (qtyFromStore <= 1) {
                  remove(baseKey);
                } else {
                  dec(baseKey);
                }
              }}
              onPointerDown={setRipple}
              className="h-9 w-9 grid place-items-center hover:bg-white/10 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70 rounded-l-full"
              aria-label={qtyFromStore <= 1 ? "Remove from cart" : "Decrease quantity"}
              title={qtyFromStore <= 1 ? "Remove" : "Decrease"}
            >
              <Icon name={qtyFromStore <= 1 ? "trash" : "minus"} className="w-4 h-4 text-white" />
              <span className="btn-ripple" aria-hidden />
            </button>
            <span className="px-2 text-xs font-semibold text-white">{qtyFromStore}</span>
            <button
              onClick={(e) => {
                setRipple(e);
                vibrate(6);
                inc(baseKey);
              }}
              onPointerDown={setRipple}
              className="h-9 w-9 grid place-items-center hover:bg-white/10 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70 rounded-r-full"
              aria-label="Increase quantity"
              title="Increase"
            >
              <Icon name="plus" className="w-4 h-4 text-white" />
              <span className="btn-ripple" aria-hidden />
            </button>
          </div>
        )}
      </div>

      {/* TEXT */}
      <div className="p-3 sm:p-3.5">
        <h3 className="font-semibold leading-tight text-[0.95rem] line-clamp-2">
          {itemName}
        </h3>

        {/* Price (UnitPrice + Tax1Amount) */}
        <div className="mt-1.5 text-[1.05rem] sm:text-[1.15rem] font-extrabold text-slate-900">
          AED {totalPrice.toFixed(2)}
        </div>

        {(item.subtitle || item.desc) && (
          <p className="mt-1 text-slate-500 text-[0.8rem] leading-relaxed line-clamp-2">
            {item.subtitle || item.desc}
          </p>
        )}
      </div>

      {/* a11y live region */}
      <span ref={liveRef} className="sr-only" aria-live="polite" />
    </article>
  );
} 