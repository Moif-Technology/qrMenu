# qrmenu-dashboard backend — copy to .env and fill in
DASHBOARD_PORT=5002
DASHBOARD_JWT_SECRET=change-me-to-a-long-random-string
DASHBOARD_JWT_EXPIRES=12h
# Set exact origin in production, e.g. https://dashboard.deynoqr.com
DASHBOARD_CORS_ORIGIN=http://localhost:5174

# Same SQL Server the main qrMenu backend uses. DB_PASSWORD is REQUIRED.
DB_USER=sa
DB_PASSWORD=
DB_SERVER=MOIF\SQLEXPRESS
DB_NAME=PaymentGateway
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Optional: pin seed passwords instead of random generation (leave unset to auto-generate)
# SEED_COMPANY_PASSWORD=
# SEED_OPAIA_PASSWORD=
