# qrmenu-dashboard backend
DASHBOARD_PORT=5002
DASHBOARD_JWT_SECRET=change-me-to-a-long-random-string
DASHBOARD_JWT_EXPIRES=12h
# Comma not supported; set exact origin in production, e.g. https://dashboard.deynoqr.com
DASHBOARD_CORS_ORIGIN=http://localhost:5174

# Same SQL Server the main qrMenu backend uses
DB_USER=sa
DB_PASSWORD=motech
DB_SERVER=MOIF\SQLEXPRESS
DB_NAME=PaymentGateway
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Seed passwords (used only by npm run seed:users)
SEED_COMPANY_PASSWORD=company123
SEED_OPAIA_PASSWORD=opaia123
